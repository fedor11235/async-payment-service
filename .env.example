# --- API ---
# Статический ключ, который требуется во всех запросах в заголовке X-API-Key
API_KEY=super-secret-api-key

# --- База данных ---
# Внутри docker-compose хост — postgres. Для локального запуска поменяйте на localhost.
DATABASE_URL=postgresql+asyncpg://payments:payments@postgres:5432/payments

# --- Брокер сообщений ---
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# --- Эмуляция обработки платежа в consumer ---
PROCESS_MIN_SECONDS=2
PROCESS_MAX_SECONDS=5
SUCCESS_RATE=0.9

# --- Retry / DLQ ---
# Максимум попыток обработки сообщения до отправки в Dead Letter Queue
MAX_RETRIES=3
# Базовая задержка (сек) для экспоненциального бэкоффа: delay = base * 2**attempt
RETRY_BASE_DELAY=2

# --- Outbox relay ---
# Период опроса таблицы outbox (сек)
OUTBOX_POLL_INTERVAL=0.5
# Сколько событий забирать за одну итерацию
OUTBOX_BATCH_SIZE=100
